# Ignore everything at the root, then re-open only what we want
/*
!/.gitignore

!/resources/
/resources/*
!/resources/views/
/resources/views/*
!/resources/views/layouts/
/resources/views/layouts/*
!/resources/views/layouts/sigma/

!/modules/
/modules/*
!/modules/CrewNews/
!/modules/FlightOperations/

!/public/
/public/*
!/public/assets/
/public/assets/*
!/public/assets/sigma/