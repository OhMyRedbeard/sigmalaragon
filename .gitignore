# Ignore everything at the root, then re-open only what we want
/*
!/.gitignore

!/resources/
/resources/*
!/modules/
/modules/*
!/resources/views/
/resources/views/*
!modules/FlightOperations/
/modules/FlightOperations/*
!/resources/views/layouts/
/resources/views/layouts/*
!/resources/views/layouts/sigma/

!/public/
/public/*
!/public/assets/
/public/assets/*
!/public/assets/sigma/

!/modules/
/modules/*
!/modules/CrewNews/**
!/modules/FlightOperations/**