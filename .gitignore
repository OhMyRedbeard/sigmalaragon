# 1. Ignore everything at the root level
/*

# 2. Open the paths down to your target folders
!/resources/
/resources/*
!/resources/views/
/resources/views/*
!/resources/views/layouts/
/resources/views/layouts/*

!/public/
/public/*
!/public/assets/
/public/assets/*

# 3. Whitelist the folders AND all of their nested contents
!/resources/views/layouts/sigma/
!/resources/views/layouts/sigma/**

!/public/assets/sigma/
!/public/assets/sigma/**

# 4. Keep the .gitignore file tracked
!.gitignore